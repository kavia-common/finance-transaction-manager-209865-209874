# Required environment variables for the Banking Backend API

# PostgreSQL connection URL, e.g.:
# postgresql+asyncpg is not required for asyncpg driver here; use standard postgres URL:
# postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://postgres:postgres@localhost:5432/banking

# JWT secret key used to sign tokens
SECRET_KEY=change_me_in_production

# Access token expiration in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed origins for CORS
CORS_ALLOW_ORIGINS=http://localhost:3000
