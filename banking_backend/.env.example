# Copy this file to .env and adjust for your environment.

# PostgreSQL connection string
# Example matches the companion database container defaults
DATABASE_URL=postgresql://appuser:dbuser123@localhost:5000/myapp

# Secret key for signing JWTs (use a strong random value in production)
SECRET_KEY=dev-secret-change-me

# Access token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed origins for CORS
CORS_ALLOW_ORIGINS=http://localhost:3000
